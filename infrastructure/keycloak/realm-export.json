{
  "id": "tabitabe",
  "realm": "tabitabe",
  "enabled": true,
  "displayName": "Tabitabe Platform",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>Tabitabe</span></div>",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1) and notUsername",
  "supportedLocales": ["en", "ja"],
  "defaultLocale": "ja",
  "internationalizationEnabled": true,
  "defaultRole": {
    "id": "default-role-tabitabe",
    "name": "customer_free",
    "description": "Default role for new users"
  },
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Super Administrator - Full system access",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["global"]
        }
      },
      {
        "name": "global_operations",
        "description": "Global Operations Manager",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["global"]
        }
      },
      {
        "name": "region_admin",
        "description": "Regional Administrator",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["region"]
        }
      },
      {
        "name": "restaurant_approval_specialist",
        "description": "Restaurant Approval Specialist",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["region"]
        }
      },
      {
        "name": "content_moderator",
        "description": "Content Moderator",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["region"]
        }
      },
      {
        "name": "customer_support_agent",
        "description": "Customer Support Agent",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["region"]
        }
      },
      {
        "name": "campaign_manager",
        "description": "Campaign Manager",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["region"]
        }
      },
      {
        "name": "government_admin",
        "description": "Government Administrator",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["region"]
        }
      },
      {
        "name": "government_analyst",
        "description": "Government Analyst",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["region"]
        }
      },
      {
        "name": "restaurant_owner",
        "description": "Restaurant Owner",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["entity"]
        }
      },
      {
        "name": "restaurant_manager",
        "description": "Restaurant Manager",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["entity"]
        }
      },
      {
        "name": "restaurant_staff",
        "description": "Restaurant Staff",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["entity"]
        }
      },
      {
        "name": "restaurant_viewer",
        "description": "Restaurant Viewer",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["entity"]
        }
      },
      {
        "name": "customer_premium_plus",
        "description": "Premium Plus Customer",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["entity"]
        }
      },
      {
        "name": "customer_premium",
        "description": "Premium Customer",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["entity"]
        }
      },
      {
        "name": "customer_free",
        "description": "Free Customer",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "scope_level": ["entity"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "tabitabe-web",
      "name": "Tabitabe Web Application",
      "description": "Main web application",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "tabitabe-web-secret-change-in-production",
      "redirectUris": [
        "http://localhost:8000/*",
        "http://localhost:3000/*",
        "https://tabitabe.com/*",
        "https://api.tabitabe.com/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://localhost:3000",
        "https://tabitabe.com",
        "https://api.tabitabe.com"
      ],
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "access.token.lifespan": "3600",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "region",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "region",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "region",
            "jsonType.label": "String"
          }
        },
        {
          "name": "scope_level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "scope_level",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "scope_level",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "tabitabe-mobile",
      "name": "Tabitabe Mobile App",
      "description": "Mobile application (iOS/Android)",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "tabitabe://oauth/callback",
        "com.tabitabe.app://oauth/callback"
      ],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "tabitabe-admin",
      "name": "Tabitabe Admin Portal",
      "description": "Admin portal for system administrators",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "tabitabe-admin-secret-change-in-production",
      "redirectUris": [
        "http://localhost:8000/admin/*",
        "https://admin.tabitabe.com/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "https://admin.tabitabe.com"
      ],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "description": "User roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    }
  ],
  "defaultDefaultClientScopes": [
    "email",
    "profile",
    "roles"
  ],
  "smtpServer": {
    "host": "",
    "port": "",
    "from": "",
    "fromDisplayName": "Tabitabe Platform",
    "auth": true,
    "ssl": false,
    "starttls": true
  },
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ja"],
  "defaultLocale": "ja"
}
