# ==============================================
# DJANGO SETTINGS
# ==============================================
DJANGO_SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==============================================
# DATABASE SETTINGS (PostgreSQL)
# ==============================================
DB_NAME=tabitabe_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ==============================================
# REDIS SETTINGS
# ==============================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================
# MINIO SETTINGS (S3-compatible storage)
# ==============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=False
MINIO_BUCKET_NAME=tabitabe-media
MINIO_PUBLIC_BUCKET=tabitabe-public

# ==============================================
# KEYCLOAK SETTINGS (OIDC)
# ==============================================
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=tabitabe
KEYCLOAK_CLIENT_ID=tabitabe-backend
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret-here

# OIDC Endpoints
OIDC_RP_CLIENT_ID=tabitabe-backend
OIDC_RP_CLIENT_SECRET=your-keycloak-client-secret-here
OIDC_OP_AUTHORIZATION_ENDPOINT=http://localhost:8080/realms/tabitabe/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=http://localhost:8080/realms/tabitabe/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://localhost:8080/realms/tabitabe/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=http://localhost:8080/realms/tabitabe/protocol/openid-connect/certs
OIDC_RP_SIGN_ALGO=RS256

# ==============================================
# EMAIL SETTINGS
# ==============================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@tabitabe.com

# ==============================================
# GOOGLE MAPS API
# ==============================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ==============================================
# FRONTEND SETTINGS
# ==============================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=tabitabe
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=tabitabe-frontend
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ==============================================
# CORS SETTINGS
# ==============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ==============================================
# SENTRY (Error Tracking) - Optional
# ==============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ==============================================
# APPLICATION SETTINGS
# ==============================================
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:8000/admin
